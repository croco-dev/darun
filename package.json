{
  "name": "darun",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "codegen": "turbo codegen",
    "dev": "turbo dev",
    "format": "turbo lint -- --fix",
    "lint": "turbo lint",
    "local": "docker compose -f docker-compose.yml",
    "local:bootstrap": "DATABASE_URL=postgresql://darun:darun@localhost:5432/darun pnpm --filter graphql-api local:bootstrap",
    "local:down": "docker compose -f docker-compose.yml down",
    "local:logs": "docker compose -f docker-compose.yml logs -f",
    "local:up": "docker compose -f docker-compose.yml up -d",
    "prepare": "lefthook install",
    "test": "turbo test",
    "test:coverage": "turbo test -- --coverage",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@darun/eslint-config": "workspace:*",
    "@darun/utils-llm": "workspace:*",
    "@darun/utils-tsconfig": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/react-table": "8.21.3",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "autoprefixer": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-boundaries": "6.0.2",
    "eslint-plugin-import-x": "4.16.1",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "lefthook": "catalog:",
    "lucide-react": "catalog:",
    "prettier": "catalog:",
    "react-day-picker": "catalog:",
    "react-dropzone": "catalog:",
    "react-hook-form": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f",
  "engines": {
    "node": ">=22",
    "pnpm": "11.2.2"
  }
}
