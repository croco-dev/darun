{
  "name": "darun",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "codegen": "turbo codegen",
    "dev": "turbo dev",
    "eval:llm-content": "tsx scripts/eval-llm-content/run.ts",
    "format": "oxfmt && OXLINT_TSGOLINT_PATH=node_modules/.bin/tsrs-lint oxlint --fix",
    "lint": "OXLINT_TSGOLINT_PATH=node_modules/.bin/tsrs-lint oxlint && oxfmt --check",
    "local": "docker compose -f docker-compose.yml",
    "local:bootstrap": "DATABASE_URL=postgresql://darun:darun@localhost:5432/darun pnpm --filter graphql-api local:bootstrap",
    "local:down": "docker compose -f docker-compose.yml down",
    "local:logs": "docker compose -f docker-compose.yml logs -f",
    "local:reset": "DATABASE_URL=postgresql://darun:darun@localhost:5432/darun pnpm --filter graphql-api local:reset",
    "local:sync-search": "pnpm --filter graphql-api local:sync-search",
    "local:up": "docker compose -f docker-compose.yml up -d",
    "prepare": "lefthook install",
    "test": "pnpm run test:eval-llm-content && turbo test",
    "test:coverage": "turbo test -- --coverage",
    "test:eval-llm-content": "tsx --test scripts/eval-llm-content/run.test.ts",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@darun/utils-llm": "workspace:*",
    "@darun/utils-tsconfig": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/react-table": "8.21.3",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "autoprefixer": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "eslint-import-resolver-typescript": "3.8.1",
    "eslint-plugin-boundaries": "6.0.2",
    "lefthook": "catalog:",
    "lucide-react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react-day-picker": "catalog:",
    "react-dropzone": "catalog:",
    "react-hook-form": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tsrs": "7.1.0-beta.tsrs5",
    "tsx": "4.22.4",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f",
  "engines": {
    "node": ">=22",
    "pnpm": "11.2.2"
  }
}
