# INFRA_ENV: 인프라 환경 식별자. local(로컬 개발) 또는 prod(실제 운영)만 사용합니다.
INFRA_ENV=local
# RUNNING_ENV: 런타임 환경 식별자. Sentry 환경 이름과 Cloudinary 폴더 prefix에 영향을 줍니다. 운영 환경에서는 prod로 유지해야 합니다.
RUNNING_ENV=local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/darun
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
MONGODB_URI=mongodb://localhost:27017/darun
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENTRY_AUTH_TOKEN=
OPEN_ROUTER_API_KEY=
CURSOR_SIGNATURE_SECRET=
# VISUAL_FLOW_WRITES_ENABLED: UX 플로 등록·수정·삭제 mutation 허용 여부. 정확히 'true'일 때만 쓰기를 허용하며 그 외 값은 product-flow/writes-disabled로 거절한다. 기본값 false.
VISUAL_FLOW_WRITES_ENABLED=false
VOTE_IP_SALT=
