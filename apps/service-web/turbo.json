{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "GRAPHQL_INTERNAL_URL",
        "ENABLE_EXPERIMENTAL_REACT_COMPILER",
        "BUNDLE_ANALYZE"
      ],
      "passThroughEnv": [
        "FIREBASE_PRIVATE_KEY",
        "FIREBASE_CLIENT_EMAIL",
        "FIREBASE_AUTH_EMULATOR_HOST",
        "SENTRY_AUTH_TOKEN",
        "CI"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/visual-web/vercel.json",
        "$TURBO_ROOT$/scripts/vitest/sentry-initialization.test.mjs"
      ]
    },
    "dev": {
      "env": [
        "GRAPHQL_INTERNAL_URL",
        "ENABLE_EXPERIMENTAL_REACT_COMPILER",
        "BUNDLE_ANALYZE"
      ],
      "passThroughEnv": [
        "FIREBASE_PRIVATE_KEY",
        "FIREBASE_CLIENT_EMAIL",
        "FIREBASE_AUTH_EMULATOR_HOST",
        "SENTRY_AUTH_TOKEN",
        "CI"
      ]
    }
  }
}
