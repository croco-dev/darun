{
  "name": "tier-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cloudflare:build": "opennextjs-cloudflare build",
    "deploy": "pnpm cloudflare:build && opennextjs-cloudflare deploy -- --keep-vars",
    "dev": "next dev --port 3003",
    "lint": "eslint .",
    "preview": "pnpm cloudflare:build && opennextjs-cloudflare preview",
    "start": "next start --port 3003",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "next typegen && tsc --noEmit",
    "upload": "pnpm cloudflare:build && opennextjs-cloudflare upload"
  },
  "dependencies": {
    "@croco/utils-next-font-pretendard": "0.0.5",
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-tooltip": "1.2.8",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.86.2",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "next": "16.3.8",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "tailwind-merge": "3.4.0",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@darun/eslint-config": "workspace:*",
    "@darun/utils-tsconfig": "workspace:*",
    "@opennextjs/cloudflare": "1.20.10",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "25.2.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dotenv": "17.2.3",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "jsdom": "29.0.2",
    "postgres": "3.4.8",
    "rclone.js": "0.6.6",
    "tailwindcss": "catalog:",
    "tsx": "4.22.4",
    "tw-animate-css": "1.4.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.148.0"
  }
}
