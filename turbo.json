{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["COREPACK_HOME"],
  "globalDependencies": ["**/.env.*local", "tailwind.config.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "prepare"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "codegen": {
      "cache": false,
      "dependsOn": ["^codegen"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["prepare"],
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", "__tests__/**", "src/**", "vitest.config.{ts,js}", "vitest.setup.{ts,js}"],
      "outputs": ["coverage/**"]
    },
    "prepare": {
      "cache": false,
      "dependsOn": ["^prepare"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^typecheck"]
    },
    "typecheck:tsrs": {
      "cache": true,
      "dependsOn": ["^typecheck:tsrs"]
    }
  }
}
